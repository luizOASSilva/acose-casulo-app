# APLICACAO (LARAVEL)
APP_NAME="acose_casulo_app"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.seudominio.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
FRONTEND_URL=https://seudominio.com

# BANCO DE DADOS — INFORMAR OS DADOS DO SEU PROVEDOR
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casulo_db
DB_USERNAME=casulo_user
DB_PASSWORD=

# ARMAZENAMENTO, LOGS, CACHE E FILAS
FILESYSTEM_DISK=public
LOG_CHANNEL=stderr
LOG_LEVEL=warning
CACHE_STORE=database
QUEUE_CONNECTION=sync

# EMAIL — RESEND (CRIAR CONTA, VERIFICAR DOMINIO E GERAR API KEY)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@seudominio.com
MAIL_FROM_NAME="Projeto Casulo"
# Somente para envio via SMTP, se o projeto for adaptado para esse modo:
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# MERCADO PAGO — CREDENCIAIS DA APLICACAO E SEGREDO DO WEBHOOK
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# GOOGLE ANALYTICS 4 — PROPRIEDADE GA4 E OAUTH (GOOGLE CLOUD)
# Os dois IDs abaixo devem apontar para a mesma propriedade, se ambos forem usados.
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_AUTH_MODE=oauth
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=
GOOGLE_ANALYTICS_CACHE_SECONDS=600
# Somente se o codigo for configurado para autenticacao por conta de servico:
# GOOGLE_ANALYTICS_CREDENTIALS_PATH=storage/app/private/analytics/service-account-credentials.json

# PAINEL ADMINISTRATIVO
# Escolha um identificador unico; nao reutilize identificadores expostos.
PANEL_SLUG=

# ADMINISTRADOR MASTER — EXIGIDO PELO MasterAdminSeeder
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_NAME="Administrador"
MASTER_ADMIN_PASSWORD=

# MIGRACOES / SEEDERS — MANTER DESATIVADO NO BOOT EM PRODUCAO
RUN_FRESH_MIGRATIONS=false
RUN_SEEDERS=false

# AUTENTICACAO / SESSOES (AJUSTAR DOMINIOS AO DEPLOY)
SANCTUM_STATEFUL_DOMAINS=seudominio.com,api.seudominio.com,localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000
SESSION_DOMAIN=.seudominio.com
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
